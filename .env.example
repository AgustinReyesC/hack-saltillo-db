# Copia este archivo a `.env` y ajusta los valores para tu entorno local.

POSTGRES_DB=inventario
POSTGRES_USER=inventario
POSTGRES_PASSWORD=inventario
POSTGRES_PORT=5432

# Filtro de contexto de Liquibase (flag `--context-filter`).
# `seed` = esquema + datos de ejemplo. Cualquier otro valor (p.ej. `base`) = solo el esquema,
# porque los changesets de esquema no tienen contexto y siempre se aplican.
LIQUIBASE_CONTEXT_FILTER=seed
