# Copia este archivo a `.env` y ajusta los valores para tu entorno local.

POSTGRES_DB=inventario
POSTGRES_USER=inventario
POSTGRES_PASSWORD=inventario
POSTGRES_PORT=5432

# Contextos de Liquibase. `seed` carga datos de ejemplo (proveedores, herramientas,
# catálogo de muestra). Deja vacío para aplicar solo el esquema.
LIQUIBASE_CONTEXTS=seed
